# 香港 —— 自定义规则
# 引用:RULE-SET,<base>/rules/hk.list,香港,extended-matching
# 合并自:HK.yaml(已废弃)
# 最后更新:2026-08-01

DOMAIN-SUFFIX,fluidkey.com
# CTM 澳门电讯
DOMAIN-SUFFIX,ctm.net
# Ether.fi
DOMAIN-SUFFIX,ether.fi
DOMAIN-KEYWORD,etherfi
# dtcpay
DOMAIN-SUFFIX,dtcpay.com
DOMAIN-SUFFIX,dtcpayment.net

# 菲律宾 Maya(原 PayMaya)—— 自定义规则
# 引用:RULE-SET,<base>/rules/maya.list,<策略组>,extended-matching
# 最后更新:2026-09-25
# 说明:只用 DOMAIN-SUFFIX,Surge / Clash(mihomo)/ Shadowrocket / Loon 通用
#
# 归属核验方式:
#   - 各域名的 M365 邮箱租户名一一对应(maya-ph / paymaya-com / mayabank-ph /
#     voyagerinnovation-com .mail.protection.outlook.com)
#   - support.maya.ph 与 support.mayabank.ph 指向同一个 Salesforce 组织
#     (00d7f000003idjcuai.live.siteforce.com)
#   - support.paymaya.com 的 CNAME 就是 support.voyagerinnovation.com
#   - 后端主要落在 AWS ap-southeast-1(新加坡),不在菲律宾本地

# ---- Maya 钱包 / App(现用品牌)----
# 覆盖 api / app / assets / pg / pg-sandbox / payments / business / manager /
#   developers / support 等子域
DOMAIN-SUFFIX,maya.ph

# ---- PayMaya(旧品牌,App 与商户接口仍大量使用)----
# 注:paymaya.com 疑似开了泛解析(随便一个子域都能解析),一条后缀全收
DOMAIN-SUFFIX,paymaya.com

# ---- Maya Bank(数字银行)----
DOMAIN-SUFFIX,mayabank.ph

# ---- Voyager Innovations(Maya 的母公司 / 技术平台)----
DOMAIN-SUFFIX,voyagerinnovation.com

# ================================================================
# 可选
# ================================================================
# Smart Padala(同属 PLDT/Voyager 体系的汇款网络,不用可不开)
DOMAIN-SUFFIX,smartpadala.ph
# paymaya.io:AWS 托管,顶级域名本身没有 A 记录,子域没枚举到,用途不明
DOMAIN-SUFFIX,paymaya.io
# mayabank.com:有 M365 租户 mayabank-com,但顶级域名不解析,疑似只用于邮件或防御性注册
DOMAIN-SUFFIX,mayabank.com


# ================================================================
# Wi-Fi Calling(来源:SimHub,逐条核实)
# ================================================================
# 🇭🇰 香港 MCC 454:按国家整段收,覆盖所有香港运营商的 ePDG 域名
DOMAIN-SUFFIX,mcc454.pub.3gppnetwork.org
# 3 香港(和记)
DOMAIN-SUFFIX,wlan.three.com.hk
#   203.145.80.0/20、124.217.128.0/18 均由 AS10118 Hutchison Telephone 宣告
#   (SimHub 另列的 203.145.88.0/21、203.145.92.0/24、124.217.186.0/24 都在这两段内,不重复写)
IP-CIDR,203.145.80.0/20,no-resolve
IP-CIDR,124.217.128.0/18,no-resolve
# CSL / HKT(454-00)
#   注:SimHub 把 454-00 标成了「3 Hong Kong」,但 454-00 的 ePDG 实测解析到
#   120.88.224.5/6、120.88.240.5/6,两段均由 AS9444 HKT 宣告 —— 这是 CSL 的
IP-CIDR,120.88.224.0/24,no-resolve
IP-CIDR,120.88.240.0/24,no-resolve

# 🇵🇭 菲律宾(与 Maya 一样走香港)
# DITO 515-66:ePDG 实测 131.226.72.137 / 73.137,131.226.64.0/18 由 AS139831 DITO 宣告
DOMAIN-SUFFIX,mcc515.pub.3gppnetwork.org
IP-CIDR,131.226.64.0/18,no-resolve
